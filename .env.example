# Chat providers.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_THINKING_MODE=disabled
LLM_TIMEOUT=300

# Embeddings. Use local on the 4090, or set EMBEDDING_PROVIDER=openrouter.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=/autodl-pub/models/bge-large-en-v1.5
LOCAL_EMBEDDING_BATCH_SIZE=32
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# Four-block shared WRITE / RETRIEVE utility model.
UTILITY_CHECKPOINT=checkpoints/set_utility.pt
UTILITY_DEVICE=cuda
WRITE_THRESHOLD=0.5
RETRIEVE_THRESHOLD=0.5
